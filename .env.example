APP_NAME=AdegaFlow AI API
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Qwen Cloud international OpenAI-compatible endpoint.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_FALLBACK_MODEL=qwen3.6-flash
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=2
